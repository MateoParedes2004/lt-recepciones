# URL de conexión para PostgreSQL
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://admin:lt_secret_password@localhost:5432/lt_recepciones_db?schema=public"

# (Opcional) Certificado CA del proveedor de la base, en texto. Hace falta con
# proveedores que firman con una entidad propia (ej. Aiven): sin él, el backend
# no puede verificar el certificado y no conecta. Se pega completo, de
# "-----BEGIN CERTIFICATE-----" a "-----END CERTIFICATE-----". Si el panel
# aplasta los saltos de línea, sirve escribirlos como \n. Con Neon no se usa.
# DATABASE_CA_CERT=

# (Opcional) Clave gratis de Geoapify para calcular los km POR CALLE desde el
# depósito hasta la ubicación de entrega de cada alquiler. Se saca en
# https://myprojects.geoapify.com (plan Free: 3.000 cálculos por día, sin
# tarjeta, permite uso comercial). Sin ella el panel estima los km en línea
# recta × 1,3 y los marca como aproximados.
# GEOAPIFY_API_KEY=

# Credenciales de Cloudinary (subida de imágenes)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Clave usada para firmar los tokens JWT del panel admin.
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen(es) permitido(s) para CORS: la URL del frontend, sin barra final.
# Se pueden poner varios separados por coma, p. ej. para probar en local por
# localhost y por 127.0.0.1:  http://localhost:3001,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3001

PORT=3000

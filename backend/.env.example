# URL de conexión para PostgreSQL
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://admin:lt_secret_password@localhost:5432/lt_recepciones_db?schema=public"

# Credenciales de Cloudinary (subida de imágenes)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Clave usada para firmar los tokens JWT del panel admin.
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS (la URL del frontend)
FRONTEND_URL=http://localhost:3001

PORT=3000

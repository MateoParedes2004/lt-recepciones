generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  // Texto corto que se muestra bajo el título de la categoría en el catálogo.
  description String?
  // Orden en el catálogo: menor número primero. Dos rubros con el mismo número
  // se ordenan por id. Los rubros existentes arrancan con id × 10 (ver
  // CategoryOrderMigration), así que el orden actual no cambia.
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  // Inventario FÍSICO: cuántas unidades tiene el negocio en total. Cuántas están
  // libres NO se guarda: se calcula a partir de los alquileres activos que se
  // solapan con las fechas que se consulten (ver AvailabilityService).
  totalStock  Int      @default(0)
  pricePerDay Decimal  @db.Decimal(10, 2)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rentalItems RentalItem[]

  // Baja lógica: se usa en vez de borrar de verdad cuando el producto ya
  // tiene alquileres asociados, para no perder el detalle histórico ni
  // distorsionar retroactivamente las estadísticas de ingresos. Desaparece
  // del catálogo público y del selector de alquileres, pero el producto
  // sigue existiendo para que el histórico se mantenga intacto.
  isArchived  Boolean  @default(false)

  @@index([categoryId])
  @@index([isArchived])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // Aquí guardaremos la contraseña encriptada (nunca en texto plano)
  role      String   @default("ADMIN") // Por ahora, el que se registre será Administrador
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
}

// ==========================================
// SISTEMA DE ALQUILERES
// ==========================================

model Rental {
  id          Int      @id @default(autoincrement())
  clientName  String   // Nombre del cliente
  clientPhone String?  // Teléfono (Opcional)
  eventDate   DateTime // Fecha en la que usa los productos
  returnDate  DateTime // Fecha en la que debe devolverlos
  // "PRESUPUESTO" (cotización todavía sin confirmar), "ACTIVO" (reservado /
  // en uso / atrasado: se calcula por fecha), "DEVUELTO" o "CANCELADO". Solo
  // los ACTIVO ocupan unidades del inventario; un PRESUPUESTO tampoco cuenta
  // en ingresos ni estadísticas hasta que se confirma.
  status      String   @default("ACTIVO")
  returnedAt  DateTime? // Cuándo se marcó como devuelto
  cancelledAt DateTime? // Cuándo se anuló
  // totalPrice = Σ(precio × cantidad) de los productos + shippingPrice.
  totalPrice  Float    @default(0) // El precio total en Guaraníes, envío incluido
  // Precio de envío de esta cotización puntual: se precarga con el de la
  // ciudad elegida pero el admin lo puede corregir a mano en el panel (varía
  // mucho según la dirección exacta, el tamaño del pedido, etc.). Igual que
  // RentalItem.unitPrice, queda "congelado" en el alquiler: si después
  // cambia el costo de envío de esa ciudad en Zonas de Entrega, los
  // alquileres ya cargados NO se recalculan solos.
  shippingPrice Float  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Ciudad de entrega (opcional: alquileres viejos o retiro en local no la tienen)
  cityId      Int?
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  // Lugar exacto de entrega (opcional; los alquileres viejos no lo tienen).
  // Coordenadas en grados decimales, como Google Maps. Es la base de la
  // futura app de recorridos: cada alquiler es una parada de ENTREGA el día
  // del evento (eventDate) y de RETIRO el día de devolución (returnDate).
  // El punto de partida es siempre el depósito (DEPOT en src/routing/geo.ts).
  deliveryLat     Float?
  deliveryLng     Float?
  // Referencia escrita para el que entrega ("Salón X, Av. Y c/ Z, portón negro").
  deliveryAddress String?
  // Km por calle desde el depósito, calculados al cargar la ubicación. Quedan
  // congelados como shippingPrice: si después cambia la fórmula, no se tocan.
  deliveryKm      Float?

  // Horario en que el cliente espera la entrega y el retiro (opcional, "HH:MM"
  // en hora de Paraguay). Es la ventana que respeta el planificador de rutas:
  // llegar antes obliga a esperar, llegar después se marca como atraso.
  deliveryWindowFrom String?
  deliveryWindowTo   String?
  pickupWindowFrom   String?
  pickupWindowTo     String?

  // Relación: Un alquiler tiene muchos productos adentro (ítems)
  items       RentalItem[]

  // Pedido por WhatsApp que se confirmó como este alquiler (si vino de ahí).
  checkoutIntent CheckoutIntent?

  // Facturas emitidas por este alquiler (normalmente una; más si alguna se anuló).
  invoices    Invoice[]

  // Paradas de reparto que lo incluyen (una de entrega y otra de retiro por cada ruta que se guardó).
  deliveryStops DeliveryStop[]

  @@index([eventDate])
  @@index([status])
  @@index([cityId])
  // El panel lista los alquileres del más nuevo al más viejo (orderBy createdAt desc).
  @@index([createdAt])
}

model RentalItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      // Cuántas unidades de este producto se llevó

  // Precio unitario vigente al momento del alquiler (histórico). Nullable:
  // los ítems creados antes de este campo no lo tienen, y las estadísticas
  // caen de vuelta al precio actual del producto para esos casos.
  unitPrice Decimal? @db.Decimal(10, 2)

  // Color elegido por el cliente (opcional). Solo para productos del rubro
  // "Manteles" (lo valida RentalsService); aparece en el presupuesto, ej.
  // "Mantel para Tablón (Negro)". Nulo = todavía no eligió color.
  color     String?

  // Conexión con el Alquiler general
  rentalId  Int
  rental    Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // Conexión con el Producto exacto (Silla, Mesa, etc.)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  @@index([rentalId])
  @@index([productId])
}

// ==========================================
// MÓDULO DE ESTADÍSTICAS Y ANALÍTICAS
// ==========================================

model SiteVisit {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // Guardará el día exacto a la medianoche (Ej: 2026-02-16)
  count     Int      @default(1) // Empezará en 1 y se irá sumando
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contadores diarios del sitio público. Nunca guarda datos de la persona:
// solo "cuántas veces pasó X ese día". Tipos (type → qué es key):
//   pageview           → "" (páginas vistas)
//   product_view       → id del producto (fichas abiertas)
//   add_to_cart        → id del producto (agregados a la cotización)
//   search             → texto buscado en el catálogo (con resultados)
//   search_empty       → texto buscado sin resultados
//   availability_check → fecha de evento consultada en el carrito (AAAA-MM-DD)
//   whatsapp_click     → qué botón de WhatsApp (flotante, contacto, rubro…)
//   source             → de dónde llegó el visitante del día (google, instagram…)
//   device             → celular | tablet | computadora
model SiteMetric {
  id    Int      @id @default(autoincrement())
  date  DateTime // Medianoche de Paraguay de ese día (mismo criterio que SiteVisit.date)
  type  String
  key   String   @default("")
  count Int      @default(0)

  @@unique([date, type, key])
  @@index([type, date])
}

// ==========================================
// SISTEMA DE GALERÍA DE EVENTOS
// ==========================================

model GalleryImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String   // URL de la imagen en Cloudinary
  title       String?  // Título o descripción corta (Ej: "Boda en Asunción")
  // Tipo de evento (ver gallery/event-types.ts para la lista válida), para
  // poder mostrar/filtrar la galería pública por "Bodas", "Cumpleaños de 15",
  // etc. Nullable a propósito: las fotos ya subidas antes de este campo
  // quedan "sin clasificar" en vez de romper, y el panel las muestra aparte
  // para que se puedan etiquetar a mano.
  eventType   String?
  isVisible   Boolean  @default(true) // Permite ocultar fotos sin borrarlas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventType])
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float    @default(0) // El costo de envío. 0 significa que se coordina por WhatsApp (o gratis, ver freeShipping en CitiesService)
  isActive  Boolean  @default(true) // Te permitirá habilitar/deshabilitar ciudades
  // Km POR RUTA desde el local. null = todavía sin cargar.
  distanceKm       Float?
  // true: `price` lo calcula la fórmula de envío (ShippingSettings) a partir
  // de distanceKm, y se recalcula solo si cambian los km o la fórmula.
  // false: precio puesto a mano, que la fórmula nunca pisa.
  priceFromFormula Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rentals   Rental[]
}

// Fórmula del costo de envío por km (una sola fila, id = 1). Ver
// src/cities/shipping-price.ts para cómo se aplica.
model ShippingSettings {
  id                     Int      @id @default(1)
  pricePerKm             Float    @default(8000)
  freeUnderKm            Float    @default(4)
  longDistanceFromKm     Float    @default(25)
  longDistancePricePerKm Float    @default(6000)
  // null = sin límite: toda distancia tiene precio automático.
  maxKm                  Float?   @default(60)
  roundTo                Int      @default(10000)
  updatedAt              DateTime @updatedAt
}

// Señal de intención de compra: se registra cuando un cliente aprieta
// "Enviar pedido por WhatsApp" en el carrito. El checkout público no pasa
// por el backend (abre WhatsApp directo), así que esto es lo único que
// conecta "visitó el sitio" con "llegó a intentar comprar" — el cierre real
// (Rental) lo carga el admin a mano después de la conversación por WhatsApp.
model CheckoutIntent {
  id          Int      @id @default(autoincrement())
  totalAmount Float
  itemCount   Int
  cityName    String?
  // Id de la ciudad elegida en el carrito, sin clave foránea a propósito
  // (igual que CheckoutIntentItem.productId): es solo una referencia para
  // precargar el alquiler si se confirma; no debe bloquear borrar la ciudad.
  cityId      Int?
  // Fechas que eligió en el carrito (opcionales; fecha de calendario pura,
  // medianoche UTC como Rental.eventDate/returnDate).
  eventDate   DateTime?
  returnDate  DateTime?
  // PENDIENTE (recién llegado) | CONFIRMADO (se cargó el alquiler real,
  // ver rentalId) | DESCARTADO (el admin lo marcó como que no prosperó).
  status      String   @default("PENDIENTE")
  rentalId    Int?     @unique
  rental      Rental?  @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  items       CheckoutIntentItem[]

  @@index([createdAt])
  @@index([status])
}

// Qué productos llevaba cada pedido por WhatsApp ("los más pedidos").
// productId sin clave foránea a propósito: si el producto se borra, el
// histórico del pedido se conserva con el nombre que tenía.
model CheckoutIntentItem {
  id               Int            @id @default(autoincrement())
  checkoutIntentId Int
  checkoutIntent   CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  productId        Int
  productName      String
  quantity         Int

  @@index([checkoutIntentId])
  @@index([productId])
}

// Marcas internas de la aplicación (ej. "esta migración de datos ya se hizo").
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

// ==========================================
// FACTURACIÓN ELECTRÓNICA (SIFEN / DNIT)
// ==========================================

// Datos del emisor que salen impresos en cada factura (una sola fila, id = 1).
// Se precarga con los del talonario actual (ver invoices/issuer-defaults.ts).
model InvoiceSettings {
  id              Int       @id @default(1)
  businessName    String // Razón social (nombre del titular del RUC)
  tradeName       String // Nombre de fantasía
  slogan          String    @default("")
  ruc             String // Con dígito verificador: "5726203-9"
  activities      String    @default("") // Actividades económicas, una por línea
  address         String
  city            String
  phone           String    @default("")
  email           String    @default("")
  establishment   String    @default("001")
  expeditionPoint String    @default("001")
  // Timbrado ELECTRÓNICO que asigna la DNIT al habilitarse como facturador
  // electrónico (no es el del talonario de papel). Vacío = todavía sin habilitar.
  timbrado        String    @default("")
  timbradoStart   DateTime? // Fecha de inicio de vigencia (fecha de calendario, medianoche UTC)
  updatedAt       DateTime  @updatedAt
}

model Invoice {
  id              Int      @id @default(autoincrement())
  // PRUEBA = emitida con el proveedor de prueba (sin validez fiscal);
  // PRODUCCION = enviada a la DNIT de verdad. Cada ambiente numera aparte.
  environment     String
  timbrado        String
  establishment   String
  expeditionPoint String
  number          Int
  issuedAt        DateTime @default(now())
  condition       String   @default("CONTADO") // CONTADO | CREDITO

  // Receptor. customerType: RUC (contribuyente), CI (cédula, no
  // contribuyente) o SIN_NOMBRE (consumidor final sin identificar).
  customerType     String
  customerDocument String?
  customerName     String
  customerAddress  String?
  customerEmail    String?
  customerPhone    String?

  // Montos en guaraníes enteros, IVA INCLUIDO en los precios (como en el
  // talonario): taxed10 es lo vendido a la tasa del 10 % e iva10 = taxed10 / 11.
  total   Int
  taxed10 Int
  taxed5  Int
  exempt  Int
  iva10   Int
  iva5    Int

  // PENDIENTE (todavía sin respuesta de la DNIT) | APROBADA | RECHAZADA | ANULADA
  status        String    @default("PENDIENTE")
  cdc           String?   @unique // Código de control de 44 dígitos que asigna el SIFEN
  qrUrl         String?
  statusMessage String? // Motivo de rechazo o error de comunicación
  approvedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  // Copia de los datos del emisor al momento de emitir: si después se
  // editan en el panel, las facturas ya emitidas no cambian.
  issuer Json

  rentalId    Int?
  rental      Rental?       @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([environment, timbrado, establishment, expeditionPoint, number])
  @@index([rentalId])
  @@index([issuedAt])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int // Guaraníes, IVA incluido
  ivaRate     Int     @default(10) // 10 | 5 | 0 (exenta)
  total       Int // quantity × unitPrice
  // Producto del catálogo del que salió la línea (si salió de uno). Sin clave
  // foránea a propósito: la factura conserva su descripción aunque el producto se borre.
  productId   Int?

  @@index([invoiceId])
}

// ==========================================
// RUTAS DE REPARTO
// ==========================================
// El plan guardado de un día: en qué orden se entrega y se retira, a qué hora
// se espera llegar y, a medida que el chofer avanza, a qué hora llegó de verdad.
// Esas horas reales son la base para calibrar los tiempos de viaje.
model DeliveryRun {
  id             Int      @id @default(autoincrement())
  // Día del reparto, como fecha de calendario pura (medianoche UTC), igual que Rental.eventDate.
  date           DateTime @unique
  // Hora de salida del depósito, en minutos desde la medianoche de Paraguay.
  startMinutes   Int
  vehicles       Int
  // Cuánto se multiplicaron los tiempos de viaje por tráfico al planificar (1 = sin tráfico).
  trafficFactor  Float
  // "route" = tiempos por calle; "estimate" = aproximados (línea recta).
  matrixMethod   String
  // Servicio que calculó los tiempos (para mostrar su crédito), o null si fueron aproximados.
  matrixProvider String?
  // true = el plan es demostrablemente el mejor posible.
  optimal        Boolean
  totalKm        Float
  totalTravelMin Float
  finishMinutes  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  routes         DeliveryRoute[]
  stops          DeliveryStop[]
}

// El recorrido de un camión dentro de una ruta del día, con sus totales tal
// como se planificaron (incluido el regreso al depósito).
model DeliveryRoute {
  id          Int         @id @default(autoincrement())
  runId       Int
  run         DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  vehicle     Int
  travelMin   Float
  km          Float
  serviceMin  Int
  waitMin     Int
  lateMin     Int
  // Minutos desde la medianoche de Paraguay en que vuelve al depósito.
  endMinutes  Int
  durationMin Int

  @@unique([runId, vehicle])
}

model DeliveryStop {
  id                Int         @id @default(autoincrement())
  runId             Int
  run               DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rentalId          Int
  rental            Rental      @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  // "ENTREGA" o "RETIRO".
  kind              String
  // Número de camión (1, 2, ...) y posición dentro de su recorrido.
  vehicle           Int
  sequence          Int
  // Lo planificado (minutos desde la medianoche de Paraguay; tramo desde la parada anterior).
  plannedArriveMin  Int
  plannedServiceMin Int
  plannedLegMin     Float
  plannedLegKm      Float
  // Lo que pasó de verdad (marcas de tiempo reales, UTC).
  arrivedAt         DateTime?
  completedAt       DateTime?

  @@unique([runId, rentalId, kind])
  @@index([rentalId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  // Texto corto que se muestra bajo el título de la categoría en el catálogo.
  description String?
  products    Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  // Inventario FÍSICO: cuántas unidades tiene el negocio en total. Cuántas están
  // libres NO se guarda: se calcula a partir de los alquileres activos que se
  // solapan con las fechas que se consulten (ver AvailabilityService).
  totalStock  Int      @default(0)
  pricePerDay Decimal  @db.Decimal(10, 2)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rentalItems RentalItem[]

  // Baja lógica: se usa en vez de borrar de verdad cuando el producto ya
  // tiene alquileres asociados, para no perder el detalle histórico ni
  // distorsionar retroactivamente las estadísticas de ingresos. Desaparece
  // del catálogo público y del selector de alquileres, pero el producto
  // sigue existiendo para que el histórico se mantenga intacto.
  isArchived  Boolean  @default(false)

  @@index([categoryId])
  @@index([isArchived])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // Aquí guardaremos la contraseña encriptada (nunca en texto plano)
  role      String   @default("ADMIN") // Por ahora, el que se registre será Administrador
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SISTEMA DE ALQUILERES
// ==========================================

model Rental {
  id          Int      @id @default(autoincrement())
  clientName  String   // Nombre del cliente
  clientPhone String?  // Teléfono (Opcional)
  eventDate   DateTime // Fecha en la que usa los productos
  returnDate  DateTime // Fecha en la que debe devolverlos
  // "ACTIVO" (reservado / en uso / atrasado: se calcula por fecha), "DEVUELTO"
  // o "CANCELADO". Solo los ACTIVO ocupan unidades del inventario.
  status      String   @default("ACTIVO")
  returnedAt  DateTime? // Cuándo se marcó como devuelto
  cancelledAt DateTime? // Cuándo se anuló
  totalPrice  Float    @default(0) // El precio total en Guaraníes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Ciudad de entrega (opcional: alquileres viejos o retiro en local no la tienen)
  cityId      Int?
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  // Relación: Un alquiler tiene muchos productos adentro (ítems)
  items       RentalItem[]

  @@index([eventDate])
  @@index([status])
  @@index([cityId])
  // El panel lista los alquileres del más nuevo al más viejo (orderBy createdAt desc).
  @@index([createdAt])
}

model RentalItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      // Cuántas unidades de este producto se llevó

  // Precio unitario vigente al momento del alquiler (histórico). Nullable:
  // los ítems creados antes de este campo no lo tienen, y las estadísticas
  // caen de vuelta al precio actual del producto para esos casos.
  unitPrice Decimal? @db.Decimal(10, 2)

  // Conexión con el Alquiler general
  rentalId  Int
  rental    Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // Conexión con el Producto exacto (Silla, Mesa, etc.)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  @@index([rentalId])
  @@index([productId])
}

// ==========================================
// MÓDULO DE ESTADÍSTICAS Y ANALÍTICAS
// ==========================================

model SiteVisit {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // Guardará el día exacto a la medianoche (Ej: 2026-02-16)
  count     Int      @default(1) // Empezará en 1 y se irá sumando
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contadores diarios del sitio público. Nunca guarda datos de la persona:
// solo "cuántas veces pasó X ese día". Tipos (type → qué es key):
//   pageview           → "" (páginas vistas)
//   product_view       → id del producto (fichas abiertas)
//   add_to_cart        → id del producto (agregados a la cotización)
//   search             → texto buscado en el catálogo (con resultados)
//   search_empty       → texto buscado sin resultados
//   availability_check → fecha de evento consultada en el carrito (AAAA-MM-DD)
//   whatsapp_click     → qué botón de WhatsApp (flotante, contacto, rubro…)
//   source             → de dónde llegó el visitante del día (google, instagram…)
//   device             → celular | tablet | computadora
model SiteMetric {
  id    Int      @id @default(autoincrement())
  date  DateTime // Medianoche de Paraguay de ese día (mismo criterio que SiteVisit.date)
  type  String
  key   String   @default("")
  count Int      @default(0)

  @@unique([date, type, key])
  @@index([type, date])
}

// ==========================================
// SISTEMA DE GALERÍA DE EVENTOS
// ==========================================

model GalleryImage {
  id          Int      @id @default(autoincrement())
  imageUrl    String   // URL de la imagen en Cloudinary
  title       String?  // Título o descripción corta (Ej: "Boda en Asunción")
  isVisible   Boolean  @default(true) // Permite ocultar fotos sin borrarlas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Float    @default(0) // El costo de envío. 0 significa que se coordina por WhatsApp
  isActive  Boolean  @default(true) // Te permitirá habilitar/deshabilitar ciudades
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rentals   Rental[]
}

// Señal de intención de compra: se registra cuando un cliente aprieta
// "Enviar pedido por WhatsApp" en el carrito. El checkout público no pasa
// por el backend (abre WhatsApp directo), así que esto es lo único que
// conecta "visitó el sitio" con "llegó a intentar comprar" — el cierre real
// (Rental) lo carga el admin a mano después de la conversación por WhatsApp.
model CheckoutIntent {
  id          Int      @id @default(autoincrement())
  totalAmount Float
  itemCount   Int
  cityName    String?
  // Fecha del evento que eligió en el carrito (opcional; fecha de calendario
  // pura, medianoche UTC como Rental.eventDate).
  eventDate   DateTime?
  createdAt   DateTime @default(now())
  items       CheckoutIntentItem[]

  @@index([createdAt])
}

// Qué productos llevaba cada pedido por WhatsApp ("los más pedidos").
// productId sin clave foránea a propósito: si el producto se borra, el
// histórico del pedido se conserva con el nombre que tenía.
model CheckoutIntentItem {
  id               Int            @id @default(autoincrement())
  checkoutIntentId Int
  checkoutIntent   CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  productId        Int
  productName      String
  quantity         Int

  @@index([checkoutIntentId])
  @@index([productId])
}

// Marcas internas de la aplicación (ej. "esta migración de datos ya se hizo").
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}
